# Copy to .env to override defaults. All variables are optional.

# Where the database, API token, run artifacts, and traces live.
# DEVFLOW_DATA_DIR=.devflow

# Bind address. Non-loopback addresses are refused unless explicitly allowed.
# DEVFLOW_HOST=127.0.0.1
# DEVFLOW_PORT=8000
# DEVFLOW_ALLOW_REMOTE_BIND=false

# Extra directories (JSON list) under which repositories may be registered.
# More can be added in the dashboard under Settings.
# DEVFLOW_ALLOWED_ROOTS=["/Users/you/code"]

# Test runner: "docker" (sandboxed, default) or "local" (NO isolation; tests run on the
# host). "local" also requires DEVFLOW_ALLOW_UNSANDBOXED_RUNNER=true.
# DEVFLOW_RUNNER=docker
# DEVFLOW_RUNNER_IMAGE=devflow-runner:0.1
# DEVFLOW_MAX_CONCURRENT_JOBS=2

# AI CLIs. API keys are stripped from their environment unless this is true, so
# analyses use your CLI login (subscription) and never silently incur API charges.
# DEVFLOW_CLAUDE_BINARY=claude
# DEVFLOW_CODEX_BINARY=codex
# DEVFLOW_AI_PASS_API_KEYS=false
# DEVFLOW_AI_TIMEOUT_SECONDS=300

# Observability: traces exporter "file" (data dir traces.jsonl), "console", "otlp", "none".
# DEVFLOW_OTEL_EXPORTER=file
# DEVFLOW_LOG_JSON=true
# DEVFLOW_LOG_LEVEL=INFO
